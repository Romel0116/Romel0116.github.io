rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeamAdmin() {
      return signedIn()
             && exists(
               /databases/$(database)/documents/users/$(request.auth.uid)
             )
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.appRole == 'admin';
    }

    function isTeamCaptain(teamId) {
      let team = get(
        /databases/$(database)/documents/teams/$(teamId)
      ).data;

      return signedIn()
             && (
               (
                 team.keys().hasAny(['captainId'])
                 && team.captainId == request.auth.uid
               )
               ||
               (
                 !team.keys().hasAny(['captainId'])
                 && team.createdBy == request.auth.uid
               )
             );
    }

    function canManageTeam(teamId) {
      return isTeamAdmin() || isTeamCaptain(teamId);
    }

    function validExpenseData(data) {
      return data.description is string
             && data.description.size() > 0
             && data.description.size() <= 150
             && data.category in [
               'soccer_balls',
               'jerseys_uniforms',
               'field_rental',
               'league_registration',
               'referee_fees',
               'equipment',
               'tournament_fees',
               'insurance',
               'website_software',
               'other'
             ]
             && data.customCategory is string
             && data.customCategory.size() <= 100
             && (
               data.category != 'other'
               || data.customCategory.size() > 0
             )
             && data.amountCents is int
             && data.amountCents > 0
             && data.amountCents <= 100000000
             && data.expenseDate is timestamp
             && data.teamId is string
             && data.teamId.size() <= 200
             && data.teamName is string
             && data.teamName.size() > 0
             && data.teamName.size() <= 150
             && data.vendor is string
             && data.vendor.size() <= 120
             && data.paymentMethod in [
               'cash',
               'venmo',
               'credit_card',
               'debit_card',
               'check',
               'bank_transfer',
               'other'
             ]
             && data.paidBy is string
             && data.paidBy.size() <= 120
             && data.notes is string
             && data.notes.size() <= 1000;
    }

    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny([
                      'appRole',
                      'adminUpdatedAt',
                      'adminUpdatedBy'
                    ]);

      allow read: if request.auth != null;

      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid == userId
                        && request.resource.data
                           .diff(resource.data)
                           .affectedKeys()
                           .hasOnly([
                             'firstName',
                             'lastName',
                             'name',
                             'email',
                             'updatedAt'
                           ])
                      )
                      ||
                      (
                        isTeamAdmin()
                        && request.resource.data
                           .diff(resource.data)
                           .affectedKeys()
                           .hasOnly([
                             'appRole',
                             'adminUpdatedAt',
                             'adminUpdatedBy'
                           ])
                        && request.resource.data.appRole in [
                          'admin',
                          'member'
                        ]
                        && request.resource.data.adminUpdatedBy
                           == request.auth.uid
                        && request.resource.data.adminUpdatedAt
                           == request.time
                      )
                    );

      allow delete: if false;
    }

    match /teamInvites/{inviteCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.teamId is string
                    && canManageTeam(request.resource.data.teamId);

      allow update: if request.auth != null
                    && resource.data.teamId is string
                    && canManageTeam(resource.data.teamId);

      allow delete: if request.auth != null
                    && resource.data.teamId is string
                    && canManageTeam(resource.data.teamId);
    }

    match /teams/{teamId} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members is list
                    && request.auth.uid in request.resource.data.members;

      allow read: if request.auth != null
                  && (
                    request.auth.uid in resource.data.members
                    || isTeamAdmin()
                  );

      allow update: if request.auth != null
                    && (
                      !request.resource.data.keys().hasAny(['captainId'])
                      || request.resource.data.captainId
                         in request.resource.data.members
                    )
                    && (
                      canManageTeam(teamId)
                      ||
                      (
                        resource.data.members is list
                        && request.resource.data.members is list
                        && !(request.auth.uid in resource.data.members)
                        && request.auth.uid in request.resource.data.members
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.resource.data.members.size()
                           == resource.data.members.size() + 1
                        && request.resource.data
                           .diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['members', 'updatedAt'])
                        && resource.data.inviteCode is string
                        && exists(
                          /databases/$(database)/documents/teamInvites/$(resource.data.inviteCode)
                        )
                        && get(
                          /databases/$(database)/documents/teamInvites/$(resource.data.inviteCode)
                        ).data.active == true
                        && get(
                          /databases/$(database)/documents/teamInvites/$(resource.data.inviteCode)
                        ).data.teamId == teamId
                      )
                    );

      allow delete: if request.auth != null
                    && canManageTeam(teamId);

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create: if request.auth != null
                      && request.auth.uid in get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.members
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;

        allow update, delete: if false;

      }

      match /announcements/{announcementId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create: if request.auth != null
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 100
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 1500;

        allow update, delete: if false;
      }

      match /scheduleEvents/{eventId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create: if request.auth != null
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'type',
                        'title',
                        'startsAt',
                        'location',
                        'notes',
                        'paymentRequired',
                        'paymentAmountCents',
                        'paymentDescription',
                        'paymentDueAt',
                        'createdBy',
                        'createdByName',
                        'createdAt'
                      ])
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.type is string
                      && request.resource.data.type in [
                        'game',
                        'practice',
                        'meeting',
                        'tournament'
                      ]
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 100
                      && request.resource.data.startsAt is timestamp
                      && request.resource.data.location is string
                      && request.resource.data.location.size() <= 150
                      && request.resource.data.notes is string
                      && request.resource.data.notes.size() <= 1000
                      && request.resource.data.paymentRequired is bool
                      && request.resource.data.paymentAmountCents is int
                      && request.resource.data.paymentAmountCents >= 0
                      && request.resource.data.paymentAmountCents <= 999999
                      && request.resource.data.paymentDescription is string
                      && request.resource.data.paymentDescription.size() <= 120
                      && (
                        request.resource.data.paymentDueAt == null
                        || request.resource.data.paymentDueAt is timestamp
                      )
                      && (
                        request.resource.data.paymentRequired == false
                        || (
                          request.resource.data.paymentAmountCents > 0
                          && request.resource.data.paymentDescription.size() > 0
                        )
                      )
                      && request.resource.data.createdByName is string
                      && request.resource.data.createdByName.size() > 0
                      && request.resource.data.createdByName.size() <= 200
                      && request.resource.data.createdAt == request.time;

        allow update: if request.auth != null
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'type',
                           'title',
                           'startsAt',
                           'location',
                           'notes',
                           'paymentRequired',
                           'paymentAmountCents',
                           'paymentDescription',
                           'paymentDueAt',
                           'updatedAt'
                         ])
                      && request.resource.data.keys().hasOnly([
                        'type',
                        'title',
                        'startsAt',
                        'location',
                        'notes',
                        'paymentRequired',
                        'paymentAmountCents',
                        'paymentDescription',
                        'paymentDueAt',
                        'createdBy',
                        'createdByName',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.type is string
                      && request.resource.data.type in [
                        'game',
                        'practice',
                        'meeting',
                        'tournament'
                      ]
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 100
                      && request.resource.data.startsAt is timestamp
                      && request.resource.data.location is string
                      && request.resource.data.location.size() <= 150
                      && request.resource.data.notes is string
                      && request.resource.data.notes.size() <= 1000
                      && request.resource.data.paymentRequired is bool
                      && request.resource.data.paymentAmountCents is int
                      && request.resource.data.paymentAmountCents >= 0
                      && request.resource.data.paymentAmountCents <= 999999
                      && request.resource.data.paymentDescription is string
                      && request.resource.data.paymentDescription.size() <= 120
                      && (
                        request.resource.data.paymentDueAt == null
                        || request.resource.data.paymentDueAt is timestamp
                      )
                      && (
                        request.resource.data.paymentRequired == false
                        || (
                          request.resource.data.paymentAmountCents > 0
                          && request.resource.data.paymentDescription.size() > 0
                        )
                      )
                      && request.resource.data.updatedAt == request.time;

        allow delete: if request.auth != null
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid;

        match /attendance/{userId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.members;

          allow create, update: if request.auth != null
                                && request.auth.uid == userId
                                && request.auth.uid in get(
                                  /databases/$(database)/documents/teams/$(teamId)
                                ).data.members
                                && request.resource.data.keys().hasOnly([
                                  'userId',
                                  'userName',
                                  'status',
                                  'updatedAt'
                                ])
                                && request.resource.data.userId == request.auth.uid
                                && request.resource.data.userName is string
                                && request.resource.data.userName.size() > 0
                                && request.resource.data.userName.size() <= 200
                                && request.resource.data.status is string
                                && request.resource.data.status in [
                                  'going',
                                  'maybe',
                                  'cantAttend'
                                ]
                                && request.resource.data.updatedAt == request.time;

          allow delete: if request.auth != null
                        && get(
                          /databases/$(database)/documents/teams/$(teamId)
                        ).data.createdBy == request.auth.uid;
        }

        match /payments/{userId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.members;

          allow create: if request.auth != null
                        && (
                          (
                            request.auth.uid == userId
                            && request.auth.uid in get(
                              /databases/$(database)/documents/teams/$(teamId)
                            ).data.members
                            && request.resource.data.keys().hasOnly([
                              'userId', 'userName', 'status',
                              'paymentMethod', 'reportedAt'
                            ])
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.status == 'reported'
                            && request.resource.data.paymentMethod in ['venmo', 'cash']
                            && request.resource.data.userName is string
                            && request.resource.data.userName.size() > 0
                            && request.resource.data.userName.size() <= 200
                            && request.resource.data.reportedAt == request.time
                          )
                          ||
                          (
                            get(
                              /databases/$(database)/documents/teams/$(teamId)
                            ).data.createdBy == request.auth.uid
                            && userId in get(
                              /databases/$(database)/documents/teams/$(teamId)
                            ).data.members
                            && request.resource.data.keys().hasOnly([
                              'userId', 'userName', 'status', 'paymentMethod',
                              'reportedAt', 'confirmedBy', 'confirmedAt'
                            ])
                            && request.resource.data.userId == userId
                            && request.resource.data.userName is string
                            && request.resource.data.userName.size() > 0
                            && request.resource.data.userName.size() <= 200
                            && request.resource.data.status == 'confirmed'
                            && request.resource.data.paymentMethod in ['venmo', 'cash']
                            && request.resource.data.confirmedBy == request.auth.uid
                            && request.resource.data.confirmedAt == request.time
                          )
                        );

          allow update: if request.auth != null
                        && (
                          (
                            request.auth.uid == userId
                            && resource.data.status != 'confirmed'
                            && request.resource.data.keys().hasOnly([
                              'userId', 'userName', 'status',
                              'paymentMethod', 'reportedAt'
                            ])
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.status == 'reported'
                            && request.resource.data.paymentMethod in ['venmo', 'cash']
                            && request.resource.data.userName is string
                            && request.resource.data.userName.size() > 0
                            && request.resource.data.userName.size() <= 200
                            && request.resource.data.reportedAt == request.time
                          )
                          ||
                          (
                            get(
                              /databases/$(database)/documents/teams/$(teamId)
                            ).data.createdBy == request.auth.uid
                            && userId in get(
                              /databases/$(database)/documents/teams/$(teamId)
                            ).data.members
                            && request.resource.data.keys().hasOnly([
                              'userId', 'userName', 'status', 'paymentMethod',
                              'reportedAt', 'confirmedBy', 'confirmedAt'
                            ])
                            && request.resource.data.userId == userId
                            && request.resource.data.userName is string
                            && request.resource.data.userName.size() > 0
                            && request.resource.data.userName.size() <= 200
                            && request.resource.data.status == 'confirmed'
                            && request.resource.data.paymentMethod in ['venmo', 'cash']
                            && request.resource.data.confirmedBy == request.auth.uid
                            && request.resource.data.confirmedAt == request.time
                          )
                        );

          allow delete: if request.auth != null
                        && get(
                          /databases/$(database)/documents/teams/$(teamId)
                        ).data.createdBy == request.auth.uid;
        }
      }

      match /paymentSettings/{settingsId} {
        allow read: if request.auth != null
                    && settingsId == 'settings'
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create, update: if request.auth != null
                              && settingsId == 'settings'
                              && get(
                                /databases/$(database)/documents/teams/$(teamId)
                              ).data.createdBy == request.auth.uid
                              && request.resource.data.keys().hasOnly([
                                'venmoUrl', 'updatedBy', 'updatedAt'
                              ])
                              && request.resource.data.venmoUrl is string
                              && request.resource.data.venmoUrl.size() > 0
                              && request.resource.data.venmoUrl.size() <= 300
                              && request.resource.data.updatedBy == request.auth.uid
                              && request.resource.data.updatedAt == request.time;

        allow delete: if request.auth != null
                      && settingsId == 'settings'
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create: if request.auth != null
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'feature',
                        'title',
                        'sourceId',
                        'actorId',
                        'createdAt'
                      ])
                      && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.feature is string
                      && request.resource.data.feature in [
                        'announcements',
                        'schedule'
                      ]
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 150
                      && request.resource.data.sourceId is string
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /memberReadStatus/{userId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.uid in get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.members;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.auth.uid in get(
                                /databases/$(database)/documents/teams/$(teamId)
                              ).data.members
                              && request.resource.data.keys().hasOnly([
                                'userId',
                                'announcementsSeenAt',
                                'chatSeenAt',
                                'scheduleSeenAt'
                              ])
                              && request.resource.data.userId == request.auth.uid
                              && (
                                !('announcementsSeenAt' in request.resource.data)
                                || request.resource.data.announcementsSeenAt is timestamp
                              )
                              && (
                                !('chatSeenAt' in request.resource.data)
                                || request.resource.data.chatSeenAt is timestamp
                              )
                              && (
                                !('scheduleSeenAt' in request.resource.data)
                                || request.resource.data.scheduleSeenAt is timestamp
                              );

        allow delete: if false;
      }

      // Standings imported by the background job using the Admin SDK.
      match /standings/{standingsId} {
        allow read: if signedIn()
                    && standingsId == 'current'
                    && (
                      request.auth.uid in get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.members
                      || isTeamAdmin()
                    );

        allow create, update, delete: if false;
      }

      match /standingsConnection/{connectionId} {
        allow read: if signedIn()
                    && connectionId == 'settings'
                    && (
                      request.auth.uid in get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.members
                      || isTeamAdmin()
                    );

        allow create, update: if signedIn()
                              && connectionId == 'settings'
                              && get(
                                /databases/$(database)/documents/teams/$(teamId)
                              ).data.createdBy == request.auth.uid
                              && request.resource.data.keys().hasAll([
                                'sourceUrl', 'teamName', 'enabled', 'status',
                                'message', 'updatedAt', 'updatedBy'
                              ])
                              && request.resource.data.keys().hasOnly([
                                'sourceUrl', 'teamName', 'enabled', 'status',
                                'message', 'updatedAt', 'updatedBy'
                              ])
                              && request.resource.data.sourceUrl is string
                              && request.resource.data.sourceUrl.size() <= 500
                              && request.resource.data.sourceUrl.matches(
                                'https://thewoodlandstownship[.]teamsidelinesite[.]com/schedule[?].+'
                              )
                              && request.resource.data.teamName is string
                              && request.resource.data.teamName.size() > 0
                              && request.resource.data.teamName.size() <= 100
                              && request.resource.data.enabled is bool
                              && request.resource.data.status == 'pending'
                              && request.resource.data.message
                                 == 'Waiting for the next standings import.'
                              && request.resource.data.updatedBy == request.auth.uid
                              && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      match /leagueConnection/{connectionId} {
        allow read: if request.auth != null
                    && connectionId == 'settings'
                    && get(
                      /databases/$(database)/documents/teams/$(teamId)
                    ).data.createdBy == request.auth.uid;

        allow create: if request.auth != null
                      && connectionId == 'settings'
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'provider',
                        'requestedTeamName',
                        'calendarUrl',
                        'scheduleUrl',
                        'enabled',
                        'status',
                        'createdBy',
                        'createdAt',
                        'updatedAt'
                      ])
                      && request.resource.data.provider == 'teamsideline'
                      && request.resource.data.requestedTeamName is string
                      && request.resource.data.requestedTeamName.size() > 0
                      && request.resource.data.requestedTeamName.size() <= 100
                      && request.resource.data.calendarUrl is string
                      && request.resource.data.calendarUrl.size() > 0
                      && request.resource.data.calendarUrl.size() <= 500
                      && request.resource.data.scheduleUrl is string
                      && request.resource.data.scheduleUrl.size() > 0
                      && request.resource.data.scheduleUrl.size() <= 500
                      && request.resource.data.enabled is bool
                      && request.resource.data.status == 'pending'
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

        allow update: if request.auth != null
                      && connectionId == 'settings'
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid
                      && resource.data.createdBy == request.auth.uid
                      && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'requestedTeamName',
                           'calendarUrl',
                           'scheduleUrl',
                           'enabled',
                           'status',
                           'updatedAt'
                         ])
                      && request.resource.data.provider == 'teamsideline'
                      && request.resource.data.requestedTeamName is string
                      && request.resource.data.requestedTeamName.size() > 0
                      && request.resource.data.requestedTeamName.size() <= 100
                      && request.resource.data.calendarUrl is string
                      && request.resource.data.calendarUrl.size() > 0
                      && request.resource.data.calendarUrl.size() <= 500
                      && request.resource.data.scheduleUrl is string
                      && request.resource.data.scheduleUrl.size() > 0
                      && request.resource.data.scheduleUrl.size() <= 500
                      && request.resource.data.enabled is bool
                      && request.resource.data.status == 'pending'
                      && request.resource.data.updatedAt == request.time;

        allow delete: if request.auth != null
                      && connectionId == 'settings'
                      && get(
                        /databases/$(database)/documents/teams/$(teamId)
                      ).data.createdBy == request.auth.uid;
      }
    }

    match /expenses/{expenseId} {
      allow read: if isTeamAdmin();

      allow create: if isTeamAdmin()
                    && request.resource.data.keys().hasOnly([
                      'description',
                      'category',
                      'customCategory',
                      'amountCents',
                      'expenseDate',
                      'teamId',
                      'teamName',
                      'vendor',
                      'paymentMethod',
                      'paidBy',
                      'notes',
                      'createdBy',
                      'createdByName',
                      'createdAt'
                    ])
                    && validExpenseData(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdByName is string
                    && request.resource.data.createdByName.size() > 0
                    && request.resource.data.createdByName.size() <= 200
                    && request.resource.data.createdAt == request.time;

      allow update: if isTeamAdmin()
                    && request.resource.data.keys().hasOnly([
                      'description',
                      'category',
                      'customCategory',
                      'amountCents',
                      'expenseDate',
                      'teamId',
                      'teamName',
                      'vendor',
                      'paymentMethod',
                      'paidBy',
                      'notes',
                      'createdBy',
                      'createdByName',
                      'createdAt',
                      'updatedBy',
                      'updatedAt'
                    ])
                    && request.resource.data
                       .diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'description',
                         'category',
                         'customCategory',
                         'amountCents',
                         'expenseDate',
                         'teamId',
                         'teamName',
                         'vendor',
                         'paymentMethod',
                         'paidBy',
                         'notes',
                         'updatedBy',
                         'updatedAt'
                       ])
                    && validExpenseData(request.resource.data)
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isTeamAdmin();
    }
  }
}
